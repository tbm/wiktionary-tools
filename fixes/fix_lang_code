"""
Fix language code in templates
"""

__license__ = "GPL-3.0-or-later"

import sys

import click
import pywikibot

import kamusi
import kamusi.fix


@click.command()
@click.argument("page")
@click.option("--lang", default="sw", help="Language code")
def main(page, lang):
    """
    Fix language code in templates
    """
    site = pywikibot.Site("en", "wiktionary")
    page = pywikibot.Page(site, page)
    old_text = kamusi.get_entry(page.text, lang)
    if not old_text:
        print(f"No page {page} for language {lang}")
        sys.exit(1)
    new_text = kamusi.fix.fix_lang_code(old_text, lang)
    if old_text == new_text:
        print("No change")
        sys.exit(1)
    changelog = kamusi.format_changelog("Fix language code", lang)
    print(kamusi.colour_diff(old_text, new_text))
    edit = input("Store edit (Y/n): ")
    if not edit.upper() == "N":
        page.text = page.text.replace(old_text, new_text)
        page.save(changelog, minor=False)


if __name__ == "__main__":
    main()  # pylint: disable=no-value-for-parameter
