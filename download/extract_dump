"""
Extract entries for a specific entry from a MediaWiki XML dump.

We use enwiktionary-latest-pages-articles.xml.bz2 which can be
downloaded from https://dumps.wikimedia.org/enwiktionary/latest/
"""

__license__ = "GPL-3.0-or-later"

import bz2
import lzma
from pathlib import Path
import os

import click
import mwxml

import kamusi


@click.command()
@click.argument(
    "dump_file",
    type=click.Path(
        exists=True,
        dir_okay=False,
        path_type=Path,
    ),
)
@click.option(
    "--lang",
    type=str,
    required=True,
    help="Language code, e.g. sw for Swahili",
)
@click.option(
    "--out",
    required=True,
    type=click.Path(
        file_okay=False,
        path_type=Path,
    ),
    help="Directory for output",
)
def main(dump_file: Path, lang: str, out: Path) -> None:
    """
    Extract language entries from a MediaWiki XML dump
    """

    out.mkdir(parents=True, exist_ok=True)

    if dump_file.suffix == ".bz2":
        opener = bz2.open
    elif dump_file.suffix == ".xz":
        opener = lzma.open
    else:
        opener = open

    count = 0

    with opener(dump_file, "rb") as source:
        dump = mwxml.Dump.from_file(source)

        for page in dump:
            # The articles dump contains the latest revision of each page
            revision = next(iter(page), None)
            if revision is None or revision.text is None:
                continue

            entry = kamusi.get_entry(revision.text, lang)
            if not entry:
                continue

            # Avoid interpreting a page title as a filesystem path
            filename = page.title.replace("/", "_")
            filename = filename.replace("\\", "_")
            filename = filename.replace("\0", "_")

            output_file = out / filename
            output_file.write_text(entry, encoding="utf-8")

            # Stamp the file with the revision time instead of the current time
            rev_ts = float(revision.timestamp)
            os.utime(output_file, (rev_ts, rev_ts))

            count += 1

            if count % 1000 == 0:
                click.echo(f"Extracted {count} entries...", err=True)

    click.echo(f"Finished. Extracted {count} entries to {out}")


if __name__ == "__main__":
    main()  # pylint: disable=no-value-for-parameter
